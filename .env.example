# Copiez ce fichier en « .env » puis ajustez si besoin.
# En production avec Docker, la variable est déjà définie par
# docker-compose.yml / l'environnement de la plateforme : ce fichier
# sert surtout au développement local.

# SQLite (défaut) — chemin relatif au dossier prisma/ OU chemin absolu :
# DATABASE_URL=file:../db/custom.db
DATABASE_URL=file:/home/z/my-project/db/custom.db
